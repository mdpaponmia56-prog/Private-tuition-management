# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL 14+)
DATABASE_URL=postgresql://username:password@localhost:5432/tuition_db?sslmode=disable

# Authentication & Session Security
SESSION_SECRET=change-this-to-a-secure-random-64-character-string
SESSION_MAX_AGE_DAYS=7

# Initial Provisioned 3 Administrators (Used during npm run provision:admins)
ADMIN1_EMAIL=teacher.owner@tuition.bd
ADMIN1_NAME=Lead Instructor (Owner)
ADMIN1_PASSWORD=ReplaceWithStrongPassword1!

ADMIN2_EMAIL=admin2.coordinator@tuition.bd
ADMIN2_NAME=Academic Coordinator
ADMIN2_PASSWORD=ReplaceWithStrongPassword2!

ADMIN3_EMAIL=admin3.assistant@tuition.bd
ADMIN3_NAME=Tuition Assistant
ADMIN3_PASSWORD=ReplaceWithStrongPassword3!

# Storage Configuration
STORAGE_DIR=./uploads
MAX_PHOTO_SIZE_MB=2
